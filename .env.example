# The password you type once per browser.
SITE_PASSWORD="Sunnynunny"

# 32+ random bytes, base64. Signs the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# Neon (Postgres) connection string:
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Minutes before a page visit triggers a fresh search. 0 means every visit refreshes.
REFRESH_COOLDOWN_MINUTES=120

# FreeHire public API (https://freehire.me/docs/api — keyless by default):
# FREEHIRE_API_URL=https://freehire.me/api/v1
# FREEHIRE_API_KEY=

# Optional job board API keys:
# REED_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
