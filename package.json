{
  "name": "sunnynunny",
  "version": "0.1.0",
  "private": true,
  "description": "Private job board for creative-industry communications, marketing and business development roles.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "smoke:refresh": "node --env-file=.env --import tsx scripts/smoke-refresh.ts",
    "sponsor:check": "node --import tsx scripts/sponsor-check.ts",
    "smoke:test": "node --env-file=.env --import tsx scripts/live-test.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.0",
    "eslint-config-next": "16.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
